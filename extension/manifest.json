{
    "manifest_version": 3,
    "name": "TLDW AI",
    "description": "TLDW AI is a Chrome extension that uses AI to summarize YouTube videos, providing users with concise summaries of video content.",
    "version": "1.0.0",
    "permissions": [
        "tabs",
        "sidePanel"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "http://localhost:8000/*"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content/content.js"]
        }
    ],

    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "icons": {
        
    }
}