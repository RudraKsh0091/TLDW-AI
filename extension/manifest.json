{
    "manifest_version": 3,
    "name": "TLDW AI",
    "description": "AI-powered YouTube assistant that answers questions about videos, generates summaries, and helps you quickly understand long-form content using Retrieval-Augmented Generation (RAG).",
    "version": "1.0.0",
    "permissions": [
        "tabs",
        "sidePanel"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "http://localhost:8000/*"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content/content.js"]
        }
    ],

    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "icons": {

    }
}